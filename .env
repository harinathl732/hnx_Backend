# HNX Quantum Backend Configuration

# Update the 'postgres' password placeholder with the actual password you set when installing PostgreSQL/pgAdmin
DATABASE_URL=postgresql+pg8000://postgres:0000@localhost:5432/hnx_quantum

JWT_SECRET=production_super_secret_key_change_me_in_env
JWT_ALGORITHM=HS256

# Zerodha Kite Connect - Set your redirect URL here
# Local testing: http://localhost:8000/brokers/zerodha/callback
# Production: https://hnxquantum.in/brokers/zerodha/callback
ZERODHA_REDIRECT_URL=http://localhost:8000/brokers/zerodha/callback
